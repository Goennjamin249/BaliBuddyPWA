{
  "expo": {
    "name": "balibuddy",
    "slug": "balibuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ios/1024.png",
    "scheme": "balibuddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ios/180.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.balibuddy.pwa",
      "infoPlist": {
        "CFBundleDisplayName": "BaliBuddy",
        "CFBundleName": "BaliBuddy",
        "CFBundleShortVersionString": "1.0.0",
        "CFBundleVersion": "1",
        "LSRequiresIPhoneOS": true,
        "UILaunchStoryboardName": "SplashScreen",
        "UIRequiredDeviceCapabilities": [
          "armv7"
        ],
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/ios/512.png",
        "backgroundImage": "./assets/images/ios/512.png",
        "monochromeImage": "./assets/images/ios/512.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/ios/32.png",
      "name": "BaliBuddy - Offline Reise-Companion",
      "shortName": "BaliBuddy",
      "description": "Dein smarter Offline-Reise-Companion für Backpacker in Bali",
      "themeColor": "#FF9D6C",
      "backgroundColor": "#0F172A",
      "display": "standalone",
      "orientation": "portrait",
      "scope": "/",
      "startUrl": "/",
      "manifest": "./public/manifest.json",
      "meta": {
        "apple-mobile-web-app-capable": "yes",
        "apple-mobile-web-app-status-bar-style": "light",
        "apple-mobile-web-app-title": "BaliBuddy",
        "mobile-web-app-capable": "yes",
        "msapplication-TileColor": "#FF9D6C",
        "msapplication-tap-highlight": "no",
        "theme-color": "#FF9D6C",
        "viewport": "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
      },
      "icons": {
        "apple": "./assets/images/ios/180.png",
        "shortcut": "./assets/images/ios/192.png",
        "icon": "./assets/images/ios/512.png"
      },
      "splash": {
        "backgroundColor": "#0F172A",
        "image": "./assets/images/ios/1024.png",
        "resizeMode": "contain"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/ios/1024.png",
          "imageWidth": 180,
          "android": {
            "image": "./assets/images/ios/512.png",
            "imageWidth": 150
          },
          "ios": {
            "image": "./assets/images/ios/180.png"
          }
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-image",
      "expo-camera"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}