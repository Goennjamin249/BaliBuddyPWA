{
  "expo": {
    "name": "balibuddy",
    "slug": "balibuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "balibuddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.balibuddy.pwa",
      "infoPlist": {
        "CFBundleDisplayName": "BaliBuddy",
        "CFBundleName": "BaliBuddy",
        "CFBundleShortVersionString": "1.0.0",
        "CFBundleVersion": "1",
        "LSRequiresIPhoneOS": true,
        "UILaunchStoryboardName": "SplashScreen",
        "UIRequiredDeviceCapabilities": [
          "armv7"
        ],
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "BaliBuddy - Offline Reise-Companion",
      "shortName": "BaliBuddy",
      "description": "Dein smarter Offline-Reise-Companion für Backpacker in Bali. Finde Wasser, Wäschereien, ATMs, Kliniken und Fähren - auch ohne Internet!",
      "themeColor": "#FF9D6C",
      "backgroundColor": "#0F172A",
      "display": "standalone",
      "display_override": [
        "window-controls-overlay",
        "standalone",
        "minimal-ui"
      ],
      "orientation": "portrait-primary",
      "scope": "/",
      "startUrl": "/",
      "id": "balibuddy-pwa",
      "lang": "de",
      "dir": "ltr",
      "categories": [
        "travel",
        "utilities",
        "lifestyle"
      ],
      "manifest": "./public/manifest.json",
      "icons": {
        "apple": "./assets/images/icon.png",
        "shortcut": "./assets/images/icon.png",
        "icon": "./assets/images/icon.png",
        "favicon": "./assets/images/favicon.png"
      },
      "splash": {
        "backgroundColor": "#0F172A",
        "image": "./assets/images/icon.png",
        "resizeMode": "contain"
      },
      "preferRelatedApplications": false,
      "shortcuts": [
        {
          "name": "Karte öffnen",
          "shortName": "Karte",
          "url": "/smart-map",
          "icons": [
            {
              "src": "./assets/images/icon.png",
              "sizes": "192x192"
            }
          ]
        },
        {
          "name": "Notfall",
          "shortName": "Notfall",
          "url": "/sos-hub",
          "icons": [
            {
              "src": "./assets/images/icon.png",
              "sizes": "192x192"
            }
          ]
        },
        {
          "name": "Währungsrechner",
          "shortName": "Währung",
          "url": "/wallet",
          "icons": [
            {
              "src": "./assets/images/icon.png",
              "sizes": "192x192"
            }
          ]
        }
      ],
      "screenshots": [],
      "edge_side_panel": {
        "preferred_width": 400
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/icon.png",
          "imageWidth": 180,
          "android": {
            "image": "./assets/images/icon.png",
            "imageWidth": 150
          },
          "ios": {
            "image": "./assets/images/icon.png"
          }
        }
      ],
      "expo-image",
      "expo-camera",
      "expo-sqlite",
      "expo-audio",
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}