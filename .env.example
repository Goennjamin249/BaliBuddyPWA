# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Database Name
MONGODB_DATABASE=balibuddy

# Init DB Secret (for database initialization endpoint)
INIT_DB_SECRET=your-secret-key-here

# Sentry Configuration (optional)
SENTRY_DSN=your-sentry-dsn-here

# Vercel Analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id-here

# MapBox/MapLibre API Key (optional - for enhanced maps)
MAPBOX_ACCESS_TOKEN=your-mapbox-token-here

# Booking.com Affiliate ID (optional)
BOOKING_COM_AFFILIATE_ID=your-affiliate-id-here

# OpenWeatherMap API Key (optional - alternative to Open-Meteo)
OPENWEATHER_API_KEY=your-openweather-key-here

# Google Maps API Key (optional - for directions)
GOOGLE_MAPS_API_KEY=your-google-maps-key-here

# Tesseract.js OCR (optional - custom worker path)
TESSERACT_WORKER_PATH=/workers/tesseract.worker.js

# Environment
NODE_ENV=development
