# BaliBuddy PWA - Environment Variables Template
# Copy this file to .env.local and fill in your API keys

# RapidAPI Key (for Booking.com API via RapidAPI)
# Get your key from: https://rapidapi.com/apidojo/api/booking-com
RAPIDAPI_KEY=your_rapidapi_key_here

# Mapbox Access Token (for maps)
# Get your token from: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
VITE_MONGODB_URI=your_mongodb_uri_here

# AIS Stream API Key (for ferry tracking)
# Get your key from: https://aisstream.io/
# Note: AISStream uses WebSocket (wss://stream.aisstream.io/v0/stream)
# API keys are required for authentication
# Cross-origin requests are not supported - use backend proxy
VITE_AISSTREAM_KEY=your_aisstream_key_here

# VAPID Keys (for Web Push Notifications)
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Sentry DSN (for error tracking)
# Get from: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=your_sentry_dsn_here

# TripAdvisor API Key (deprecated - use RAPIDAPI_KEY instead)
# EXPO_PUBLIC_TRIPADVISOR_API_KEY=your_tripadvisor_key_here