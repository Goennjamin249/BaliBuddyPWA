    "@types/mongodb": "^4.0.7",
    "@types/react": "~19.2.14",
    "eslint": "10.2.0",
    "eslint-config-expo": "~55.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2"
