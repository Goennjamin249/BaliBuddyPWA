    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "preview": "npx serve dist",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .expo node_modules dist && npm install",
    "vercel-build": "expo export"
