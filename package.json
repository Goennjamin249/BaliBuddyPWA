{
  "name": "balibuddy",
  "description": "Bali Buddy Offline Travel Guide PWA",
  "author": "Bali Buddy Team",
  "version": "1.0.0",
  "license": "MIT",
  "main": "expo-router/entry",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Goennjamin249/BaliBuddyPWA.git"
  },
  "scripts": {
    "dev": "expo start --web --clear",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "preview": "npx serve@latest dist",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .expo node_modules dist && npm install",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "dedupe": "npm dedupe",
    "vercel-build": "expo export --platform web"
  },
  "dependencies": {
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-community/netinfo": "11.5.2",
    "@shopify/flash-list": "2.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.4.3",
    "@vercel/node": "^5.7.0",
    "@vercel/speed-insights": "^2.0.0",
    "expo": "55.0.11",
    "expo-asset": "~55.0.12",
    "expo-blur": "~55.0.12",
    "expo-constants": "~55.0.11",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.11",
    "expo-image": "~55.0.8",
    "expo-linear-gradient": "~55.0.11",
    "expo-linking": "~55.0.11",
    "expo-localization": "~55.0.11",
    "expo-location": "~55.1.6",
    "expo-router": "^55.0.10",
    "expo-splash-screen": "~55.0.15",
    "expo-sqlite": "~55.0.13",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.13",
    "expo-web-browser": "~55.0.12",
    "i18next": "^26.0.3",
    "i18next-http-backend": "^3.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "nativewind": "^5.0.0-preview.3",
    "openmeteo": "^1.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.2",
    "react-leaflet": "^5.0.0",
    "react-native": "0.84.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.3.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "~19.2.14",
    "eslint": "10.2.0",
    "eslint-config-expo": "~55.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "lightningcss": "1.30.1",
    "@babel/runtime": "^7.26.10",
    "braces": "^3.0.3",
    "minimatch": "^9.0.5",
    "ws": "^8.17.1",
    "tar": "^6.2.1",
    "ip": "^2.0.1",
    "undici": "^6.21.1",
    "path-to-regexp": "^6.3.0",
    "cross-spawn": "^7.0.6",
    "semver": "^7.7.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-svg"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson"
        ]
      }
    }
  }
}
